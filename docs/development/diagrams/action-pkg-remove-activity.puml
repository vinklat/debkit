@startuml
start
note right
  argparse already compiled pkg_pattern
  (pkg_pattern_type); a bad pattern exits 2
end note

:fields = pkg_pattern (field -> compiled regex);

partition "with maybe_transaction(target.storage)" {
  :target.update();
  note right: read under history_lock:\na peer may have committed
  :prev_repo = target.snapshot();
  if (target.remove_pkg(fields) matched?) then (no)
    :raise ActionException("No packages matched the pattern.");
  else (yes)
    :ret_diff = target.diff(prev_repo);
    if (ret_diff is non-empty?) then (yes)
      :target.save();
    endif
  endif
}

if (any exception escaped the partition?) then (yes)
  :transaction_discard()
   (errors during discard are logged,
    original exception is re-raised);
  stop
else (no)
  :transaction_commit();
endif

if (output == brief?) then (yes)
  :_print_pkg_brief(ret_diff);
else (json)
  :_print_pkg_json(ret_diff);
endif
stop
@enduml
