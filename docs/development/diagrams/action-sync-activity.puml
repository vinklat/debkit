@startuml
start
if (source_repo set?) then (no)
  :raise ActionException;
  stop
endif

if (allow_release_rollback?) then (yes)
  :log warning "Release freshness checks skipped";
endif

partition "with maybe_transaction(target.storage)" {
  :target.update(skip_unreadable=True);
  note right
    under history_lock, so a peer commit
    that landed while waiting is seen;
    ReleaseNotFoundException -> log warn, continue
    ChecksumException    -> log warn, target.reset()
  end note
  :target_floor = run_floor = copy(target.release)
  (taken before any reset);
  :target_before = copy(target);
  if (verify_existing?) then (yes)
    :checker = RepoSync.over(target)
    (aliases the loaded target);
    :missing = checker.consistency_lists();
    :err, fixed = checker.check(missing, [], fix=True);
    note right
      deletions are staged in the transaction;
      the first pass copies them again
    end note
    if (err > fixed?) then (yes)
      :log warning;
    endif
  endif
  repeat
    :source.update(strict_arch=True);
    if (a later pass?) then (yes)
      if (prev_hash == source.release.hash?) then (yes)
        break
      endif
      :load target again;
      :target_floor = copy(target.release);
      note right: reads the bytes the previous\npass staged
    endif
    if (source.params.verify_gpg and not allow_release_rollback?) then (yes)
      :source.release.check_fresh_against(target_floor, now);
      if (a later pass?) then (yes)
        :source.release.check_fresh_against(run_floor, now);
      endif
      note right
        ReleaseFreshnessException -> raise;
        propagates out of the loop and
        out of the maybe_transaction CM
      end note
    endif
    :plan = source.build_sync_lists(target, indices_only);
    if (plan.is_empty()?) then (yes)
      :log "Nothing to sync";
      break
    endif
    :source.sync(target, plan.copy, plan.delete, plan.unproven);
    note right
      ChecksumException propagates (cli.py logs it)
      out of the loop and
      out of the maybe_transaction CM.
      An object still failing after the
      retries raises RepoSyncException,
      so no partial target is committed;
      an unproven index the source lacks
      is skipped instead
    end note
    :prev_hash = source.release.hash;
  repeat while (fewer than MAX_UPDATED_REPO_RETRIES passes?) is (yes)
  -> no;
  :log warning "Source repo still changing";
  note right: commits the last pass
}

if (any exception escaped the partition?) then (yes)
  :transaction_discard()
  (errors during discard are logged,
   original exception is re-raised);
  stop
else (no)
  :transaction_commit();
endif

:ret_diff = source.diff(target_before);
if (output == json?) then (yes)
  :_print_sync_json(ret_diff);
else (no)
  :_print_sync_brief(ret_diff);
endif
stop
@enduml
