@startuml
start
partition "ActionPkg(pars) — before any storage opens" {
  if (XOR of changes_filename / deb_filename?) then (no)
    :raise ActionException
     ("insert needs exactly one of ~--changes-filename or ~--deb-filename");
    stop
  endif
  if (deb_filename set and not ending in ".deb"?) then (yes)
    :raise ActionException
     (f"Invalid .deb filename: {deb_filename}");
    stop
  endif
  :open target and incoming storages;
}

if (changes_filename provided?) then (yes)
  :changes = _load_changes(incoming_storage, changes_filename)
   [Changes.load(changes_filename, digest_expected=changes_sha256)];
  :filenames = changes.get_deb_files();
  if (any Architecture token invalid or "source"?) then (yes)
    :raise ActionException;
    stop
  endif
else (no)
  :filenames = [deb_filename];
endif
partition "with maybe_transaction(target.storage)" {
  :target_before = _load_target_or_setup()
   [target.update(); target.snapshot()];
  note right
    read under history_lock: a peer may have committed;
    ReleaseNotFoundException -> target.setup(fields=DEFAULT_REPO_FIELDS)
    (creates an empty repo if none exists;
    any other read failure propagates)
  end note
  :binary_archs = target.binary_archs();
  note right: get_archs() minus "source":\nthe mirrored Sources index is read-only
  while (more filenames?) is (yes)
    :debfile = DebFile(incoming_storage, filename, comp);
    :package = debfile.get_package();
    note right
      DebFileException (Read) before any transfer:
      malformed .deb (read in DebFile()),
      Package or Source not a policy name,
      Version not a Debian version,
      unsafe pool key
    end note
    :pkg_arch = package.get_arch();
    if (pkg_arch set and not an architecture name?) then (yes)
      :raise ActionException
       ("Invalid architecture in {filename}: ...");
      note right: refused before any transfer
      stop
    endif
    if (pkg_arch == "source"?) then (yes)
      :raise ActionException
       ("Source packages are not supported yet");
      note right: refused before any transfer
      stop
    endif
    if (pkg_arch not None and != ARCH_ANY?) then (yes)
      :archs = [pkg_arch];
    else (no)
      :archs = binary_archs;
    endif
    note right: per file: neither the .changes\nfield order nor the file order\npicks a package's arches
    if (archs empty?) then (yes)
      :raise ActionException
       ("... the target Release lists no binary architecture");
      note right: refused before any transfer
      stop
    endif
    :held = target.held_digests(pool_key);
    :digests = target.transfer_from(
        incoming_storage, filename,
        path_dst=pool_key);
    if (.changes upload, digest verification on,\n and digests differ from its entry?) then (yes)
      :raise ChecksumException;
      note right: the transaction discards the staged transfer;\noff under --skip-verify
      stop
    endif
    if (pool key held, and its digests differ?) then (yes)
      :raise ActionException
       ("... already holds other bytes than ...");
      note right: the transaction discards the staged transfer
      stop
    endif
    :package.set_digests(digests);
    while (more archs?) is (yes)
      :target.insert_pkg(component, arch, package);
    endwhile (no)
  endwhile (no)
  :ret_diff = _save_if_changed(target_before)
   [target.diff(target_before); target.save() if non-empty];
}

if (any exception escaped the partition?) then (yes)
  :transaction_discard()
   (errors during discard are logged,
    original exception is re-raised);
  stop
else (no)
  :transaction_commit();
endif

if (output == brief?) then (yes)
  :_print_pkg_brief(ret_diff);
else (json)
  :_print_pkg_json(ret_diff);
endif
stop
@enduml
