@startuml
actor Caller
participant ActionPkg
participant "IncomingStorage" as Inc
participant "Changes" as Chg
participant "DebFile" as Df
participant "RepoRW\n(target)" as Tgt
participant "Storage\n(target)" as TStor
participant "maybe_transaction" as CM

Caller -> ActionPkg: insert()

ActionPkg -> Tgt: update()
Tgt --> ActionPkg: ok / ReleaseNotFoundException
opt ReleaseNotFoundException
  ActionPkg -> Tgt: setup(DEFAULT_REPO_FIELDS)
end

opt --changes-filename
  ActionPkg -> Chg: load(changes_filename, sha256)
  Chg --> ActionPkg: archs, deb_files[]
  opt invalid token or names_source_arch()
    ActionPkg -> ActionPkg: raise ActionException
  end
end
ActionPkg -> Tgt: get_archs()
Tgt --> ActionPkg: archs
ActionPkg -> ActionPkg: binary_archs = _binary_archs()\n[drop "source"]

ActionPkg -> CM: __enter__(TStor)
CM -> TStor: history_lock acquire\n[blocks; S3 times out after 300 s]
CM -> TStor: history.load() / next_id()
CM -> TStor: transaction_begin(id)\n[only if isinstance(TStor, FootmarkMixin)]

loop for filename in filenames
  ActionPkg -> Df: DebFile(Inc, filename, comp)
  ActionPkg -> Df: get_package()
  Df --> ActionPkg: package
  ActionPkg -> ActionPkg: pkg_arch = package.get_arch()
  opt pkg_arch invalid or "source"
    ActionPkg -> ActionPkg: raise ActionException\n[before any transfer]
  end
  ActionPkg -> ActionPkg: archs = [pkg_arch], or binary_archs\nfor "all" or no Architecture
  opt archs empty
    ActionPkg -> ActionPkg: raise ActionException\n[before any transfer]
  end
  ActionPkg -> Tgt: transfer_from(Inc, filename, path_dst)
  Tgt -> TStor: put / add_metadata (staged via footmarks)
  Tgt --> ActionPkg: digests
  opt .changes upload, not --skip-verify, and digests differ from its entry
    ActionPkg -> ActionPkg: raise ChecksumException\n[staged transfer discarded]
  end
  ActionPkg -> ActionPkg: package.set_digests(digests)
  loop for arch in archs
    ActionPkg -> Tgt: insert_pkg(component, arch, package)
  end
end

ActionPkg -> Tgt: diff(prev_repo)
Tgt --> ActionPkg: ret_diff
opt ret_diff non-empty
  ActionPkg -> Tgt: save()
  Tgt -> TStor: put Packages / Release (staged)
  alt GPG verification on
    Tgt -> TStor: put InRelease / Release.gpg (staged)
  else --skip-verify-gpg
    Tgt -> TStor: delete stale InRelease / Release.gpg (staged)
  end
end

ActionPkg -> CM: __exit__(None)
CM -> TStor: transaction_commit()
CM -> TStor: history.append(model)\n[only if the commit had changes]
CM -> TStor: history_lock release

ActionPkg --> Caller: brief / json output

alt exception inside the loop or save
  ActionPkg -> CM: __exit__(exc)
  CM -> TStor: transaction_discard()
  CM -> TStor: history_lock release\n[no history record written]
  note right: failure during discard\nis logged but does not\nmask the original exc
  CM --> ActionPkg: re-raise
  ActionPkg --> Caller: propagate (handled by cli.py)
end
@enduml
